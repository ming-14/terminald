{
  "name": "terminald-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "网页终端前端 —— xterm.js v6 + TypeScript",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "probe": "node probe/smoke.mjs",
    "probe:all": "node probe/all.mjs"
  },
  "dependencies": {
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
